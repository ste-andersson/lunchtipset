# Copy to .env in the repo root. Both api/ and web/ read it in development.

# Postgres (Railway: reference ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:lunch@localhost:5433/lunch

# Clerk. Leave both empty to run guest-only (IndexedDB) without sign-in.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user ids (user_...) that may manage restaurants
ADMIN_USER_IDS=

# ElevenLabs. Agents and tools are created automatically when the API starts
# (see docs/elevenlabs-agent.md). The key needs Agents read/write permission.
ELEVENLABS_API_KEY=

# Gemini reads menus from web pages, PDFs and photos
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Automatic menu fetch, Stockholm time. Empty disables it.
MENU_FETCH_CRON=30 9 * * 1-5

PORT=3001
