{
  "name": "@lunch/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env --import tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "fetch-menus": "tsx --env-file-if-exists=../.env src/scripts/fetchMenus.ts",
    "sync-agents": "tsx --env-file-if-exists=../.env src/scripts/syncAgents.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.5",
    "@google/genai": "^2.32.0",
    "@hono/node-server": "^2.1.5",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.7",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "typescript": "~6.0.2",
    "drizzle-kit": "^0.31.11"
  }
}
